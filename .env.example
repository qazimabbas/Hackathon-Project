# All secrets belong here on the server, never in a VITE_ variable.
# The only provider implemented in Phase 1. Add adapters in server/src/llm.js.
LLM_PROVIDER=gemini
# Required: replace with your own Gemini API key from Google AI Studio.
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY
# Economical model for claim extraction.
GEMINI_EXTRACT_MODEL=gemini-3.5-flash-lite
# Stronger model for judging evidence in later phases.
GEMINI_JUDGE_MODEL=gemini-3.6-flash
# Optional evidence fallback. Blank reuses GEMINI_REPEAT_MODEL if the primary is unavailable.
GEMINI_JUDGE_FALLBACK_MODEL=
# Economical model for the five repeat answers in Phase 4.
GEMINI_REPEAT_MODEL=gemini-3.5-flash-lite
# Required for saved checks in Phase 6. Keep the password private.
MONGODB_URI=mongodb+srv://REPLACE_USER:REPLACE_PASSWORD@REPLACE_CLUSTER/hallucination-visualizer
# Optional process-only DNS servers for Atlas SRV lookups. Empty uses system DNS.
MONGODB_DNS_SERVERS=
# Optional: leave empty to use free Wikipedia in Phase 3.
TAVILY_API_KEY=
# Backend port. Restart npm run dev after changing ports.
PORT=3001
# Frontend port. Vite reads this from the project-root .env.
CLIENT_PORT=5173
# Exact frontend origin allowed by the backend.
CLIENT_ORIGIN=http://127.0.0.1:5173
# Maximum answer length, in JavaScript string characters.
MAX_ANSWER_CHARS=12000
# Maximum source document length accepted for later phases.
MAX_DOCUMENT_CHARS=60000
# Maximum original question length.
MAX_QUESTION_CHARS=2000
# Maximum claims per answer. Cannot exceed 10.
MAX_CLAIMS=10
# Maximum simultaneous claim operations when checking evidence is added.
CLAIM_CONCURRENCY=3
# Maximum milliseconds for each Gemini request attempt.
LLM_TIMEOUT_MS=90000
# Retries for temporary network errors, rate limits, or server errors.
LLM_MAX_RETRIES=2
# Maximum live checks per IP per rate-limit window.
RATE_LIMIT_MAX=10
# Rate-limit window in milliseconds.
RATE_LIMIT_WINDOW_MS=900000
# Server bind address. Loopback keeps local development on this computer.
HOST=127.0.0.1
# Runtime defaults to development. Uncomment only when serving a production build.
# NODE_ENV=production
